# Application
NODE_ENV=development
PORT=3000

# --- Supabase Postgres ---
# Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL = Transaction pooler (port 6543) — use for the Nest app at runtime
# DIRECT_URL   = Direct / session mode (port 5432) — required for prisma migrate
#
# Append sslmode=require if not already present.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Telegram Mini App bot token (used for initData HMAC)
TELEGRAM_BOT_TOKEN=replace-me-bot-token

# JWT secrets (use long random strings in production)
USER_JWT_SECRET=dev-user-jwt-secret-change-me-min-32-chars
ADMIN_JWT_SECRET=dev-admin-jwt-secret-change-me-min-32-chars
USER_JWT_EXPIRES_IN=7d
ADMIN_ACCESS_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_JWT_EXPIRES_IN=7d

# Admin bootstrap (seed)
ADMIN_BOOTSTRAP_USERNAME=owner
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeOwner!123
ADMIN_BOOTSTRAP_DISPLAY_NAME=Owner

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cloudinary (upload images → store returned URL in DB)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dceyltpt5
MEDIA_MAX_BYTES=5242880

# Cookies
# For admin on Vercel + API on Render (cross-site), use:
#   COOKIE_SECURE=true
#   COOKIE_SAME_SITE=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# links.et payment receipt verification (server-only)
# Mint at https://links.et/dashboard/keys — header x-api-key
LINKS_ET_API_KEY=
